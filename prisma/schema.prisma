
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  STAFF
  ADMIN
}

enum TimeRecordType{
  START
  STOP
}

enum Plan{
  FREE
  PREMIUM
}

enum SubscriptionStatus{
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model Organization{
  id String @id @default(uuid())
  name String
  cnpj String? @unique
  email String?
  phone String?
  address String?

  // Relações
  users User[]
  products Product[]
  categories Category[]
  clients Client[]
  booklets Booklet[]
  stockEntries StockEntry[]
  stockExits StockExit[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription{
  id String @id @default(uuid())
  organizationId String @unique
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan Plan @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  startedAt DateTime @default(now())
  expiresAt DateTime?
  trialEndsAt DateTime?

  // Stripe
  stripeCustomerId String?
  stripeSubscriptionId String?
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Category{
  id String @id @default(uuid())
  name String
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Client {
  id               String  @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  cpf              String
  phone            String
  email            String?
  street           String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?
  addressReference String?
  notes            String?
  active           Boolean @default(true)

  booklets Booklet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@index([organizationId, name])
}

enum BookletParcelStatus {
  PENDING
  PAID
  CANCELLED
}

model Booklet {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  description        String?
  notes              String?
  installmentCount   Int
  installmentAmount  Decimal  @db.Decimal(10, 2)
  totalAmount        Decimal  @db.Decimal(10, 2)
  firstDueDate       DateTime @db.Date
  active             Boolean  @default(true)

  parcels BookletParcel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@index([clientId])
}

model BookletParcel {
  id        String @id @default(uuid())
  bookletId String
  booklet   Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)

  number    Int
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  status    BookletParcelStatus @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookletId, number])
  @@index([bookletId])
  @@index([bookletId, status])
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(ADMIN)

  // Relação: Organização (tenant)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relação: STAFF vinculado ao ADMIN que o criou
  createdById String?
  createdBy User? @relation("StaffCreatedByAdmin", fields: [createdById], references: [id], onDelete: SetNull)
  staffCreated User[] @relation("StaffCreatedByAdmin")

  // Relação: Registros de ponto do usuário
  timeRecords TimeRecord[]

  // Relações de estoque
  stockEntries StockEntry[]
  stockExits StockExit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model TimeRecord{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type TimeRecordType
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, timestamp])
}

model Product{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identificação
  name String
  code String?
  sku String?
  category String?

  // Estoque
  currentStock Int @default(0)
  minStock Int @default(0)
  unit String @default("UN")

  // Preços
  costPrice Decimal? @db.Decimal(10, 2)
  averageCost Decimal? @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)

  // Status
  active Boolean @default(true)

  // Fornecedor (opcional)
  supplierName String?
  supplierDoc String?

  expirationDate DateTime?

  // Relações
  stockEntries StockEntry[]
  stockExits StockExit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

model StockEntry{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da entrada
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  // Fornecedor
  supplierName String?
  supplierDoc String?

  // Nota fiscal
  invoiceNumber String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}

model StockExit{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da saída
  quantity Int
  unitPrice Decimal? @db.Decimal(10, 2)
  totalPrice Decimal? @db.Decimal(10, 2)

  // Onde foi usado
  projectName String?
  clientName String?
  serviceType String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}