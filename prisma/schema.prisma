
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  STAFF
  ADMIN
}

enum TimeRecordType{
  START
  STOP
}

enum Plan{
  FREE
  PREMIUM
}

enum SubscriptionStatus{
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model Organization{
  id String @id @default(uuid())
  name String
  cnpj String? @unique
  email String?
  phone String?
  address String?

  // Relações
  users User[]
  products Product[]
  categories Category[]
  clients Client[]
  booklets Booklet[]
  stockEntries StockEntry[]
  stockExits StockExit[]
  subscription Subscription?

  // Tipo de negócio: GYM mostra somente o módulo Academia (e esconde o sistema atual)
  businessType  BusinessType @default(STANDARD)
  // true = assinatura do sistema controlada manualmente (sem Stripe, sem tela de pagamento)
  billingExempt Boolean      @default(false)

  // Módulo Academia
  gymSettings       GymSettings?
  members           Member[]
  membershipPlans   MembershipPlan[]
  memberships       Membership[]
  payments          Payment[]
  accessEvents      AccessEvent[]
  accessDevices     AccessDevice[]
  memberCredentials MemberCredential[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription{
  id String @id @default(uuid())
  organizationId String @unique
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan Plan @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  startedAt DateTime @default(now())
  expiresAt DateTime?
  trialEndsAt DateTime?

  // Stripe
  stripeCustomerId String?
  stripeSubscriptionId String?
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Category{
  id String @id @default(uuid())
  name String
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Client {
  id               String  @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  cpf              String
  phone            String
  email            String?
  street           String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?
  addressReference String?
  notes            String?
  active           Boolean @default(true)

  booklets Booklet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@index([organizationId, name])
}

enum BookletParcelStatus {
  PENDING
  PAID
  CANCELLED
}

model Booklet {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  description        String?
  notes              String?
  installmentCount   Int
  installmentAmount  Decimal  @db.Decimal(10, 2)
  totalAmount        Decimal  @db.Decimal(10, 2)
  firstDueDate       DateTime @db.Date
  active             Boolean  @default(true)

  parcels BookletParcel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@index([clientId])
}

model BookletParcel {
  id        String @id @default(uuid())
  bookletId String
  booklet   Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)

  number    Int
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  status    BookletParcelStatus @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookletId, number])
  @@index([bookletId])
  @@index([bookletId, status])
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(ADMIN)

  // Relação: Organização (tenant)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relação: STAFF vinculado ao ADMIN que o criou
  createdById String?
  createdBy User? @relation("StaffCreatedByAdmin", fields: [createdById], references: [id], onDelete: SetNull)
  staffCreated User[] @relation("StaffCreatedByAdmin")

  // Relação: Registros de ponto do usuário
  timeRecords TimeRecord[]

  // Relações de estoque
  stockEntries StockEntry[]
  stockExits StockExit[]

  // Academia: o que este usuário (recepção) registrou
  accessEventsRegistered AccessEvent[]
  paymentsReceived       Payment[]
  membershipsCreated     Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model TimeRecord{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type TimeRecordType
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, timestamp])
}

model Product{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identificação
  name String
  code String?
  sku String?
  category String?

  // Estoque
  currentStock Int @default(0)
  minStock Int @default(0)
  unit String @default("UN")

  // Preços
  costPrice Decimal? @db.Decimal(10, 2)
  averageCost Decimal? @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)

  // Status
  active Boolean @default(true)

  // Fornecedor (opcional)
  supplierName String?
  supplierDoc String?

  expirationDate DateTime?

  // Relações
  stockEntries StockEntry[]
  stockExits StockExit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

model StockEntry{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da entrada
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  // Fornecedor
  supplierName String?
  supplierDoc String?

  // Nota fiscal
  invoiceNumber String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}

model StockExit{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da saída
  quantity Int
  unitPrice Decimal? @db.Decimal(10, 2)
  totalPrice Decimal? @db.Decimal(10, 2)

  // Onde foi usado
  projectName String?
  clientName String?
  serviceType String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}

// ================= Tipo de negócio =================

enum BusinessType {
  STANDARD
  GYM
}

// ================= Módulo Academia =================
// Usado somente por organizações com businessType = GYM.

enum MemberStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum DeactivationReason {
  AUTO_ABSENCE
  AUTO_PLAN_EXPIRED
  MANUAL
}

enum NotificationType {
  MEMBER_AT_RISK
  MEMBER_DEACTIVATED
  MEMBER_REACTIVATED
  PLAN_EXPIRING
  PLAN_EXPIRED
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

enum CredentialType {
  PASSWORD
  FINGERPRINT
  CARD
}

enum AccessMethod {
  MANUAL
  PASSWORD
  FINGERPRINT
  CARD
}

enum AccessDirection {
  IN
  OUT
}

enum AccessResult {
  GRANTED
  DENIED
}

model GymSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  atRiskAfterDays         Int     @default(7)
  inactiveAfterDays       Int     @default(30)
  autoDeactivate          Boolean @default(true)
  autoReactivateOnCheckIn Boolean @default(true)
  planExpiringNoticeDays  Int     @default(5)
  deactivateOnPlanExpired Boolean @default(false)
  planExpiredGraceDays    Int     @default(5)
  notifyAtRisk            Boolean @default(true)

  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Aluno da academia (separado de Client, que é do sistema de carnês).
model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  cpf       String?
  phone     String?
  email     String?
  birthDate DateTime? @db.Date
  notes     String?

  /// Senha numérica digitada na catraca. Única por academia.
  accessCode String?

  memberStatus       MemberStatus        @default(ACTIVE)
  autoControl        Boolean             @default(true)
  lastCheckInAt      DateTime?
  /// Início da contagem de ausência (cadastro ou última reativação)
  activeSince        DateTime            @default(now())
  statusChangedAt    DateTime?
  deactivatedAt      DateTime?
  deactivationReason DeactivationReason?

  /// Cópia da matrícula vigente (atualizada ao matricular/renovar), usada em filtros e regras
  planName      String?
  planExpiresAt DateTime? @db.Date

  memberships   Membership[]
  payments      Payment[]
  accessEvents  AccessEvent[]
  credentials   MemberCredential[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cpf])
  @@unique([organizationId, accessCode])
  @@index([organizationId, memberStatus])
  @@index([organizationId, name])
  @@index([organizationId, planExpiresAt])
}

/// Plano vendido pela academia (Mensal, Trimestral...).
model MembershipPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  price          Decimal @db.Decimal(10, 2)
  durationMonths Int     @default(1)
  durationDays   Int     @default(0)
  active         Boolean @default(true)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// Matrícula: um período de plano de um aluno.
model Membership {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member          @relation(fields: [memberId], references: [id], onDelete: NoAction)
  planId         String?
  plan           MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// Cópia do nome/preço do plano no momento da matrícula
  planName  String
  price     Decimal          @db.Decimal(10, 2)
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    MembershipStatus @default(ACTIVE)
  notes     String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, endDate])
  @@index([memberId, endDate])
}

/// Mensalidade / pagamento de um aluno.
model Payment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: NoAction)
  membershipId   String?
  membership     Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  receivedById   String?
  receivedBy     User?        @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  amount  Decimal        @db.Decimal(10, 2)
  dueDate DateTime       @db.Date
  status  PaymentStatus  @default(PENDING)
  method  PaymentMethod?
  paidAt  DateTime?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, dueDate])
  @@index([memberId, dueDate])
}

/// Equipamento de acesso (catraca Topdata Inner, leitor biométrico...). O agente local se autentica com a chave.
model AccessDevice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  model      String?
  ipAddress  String?
  /// Hash (SHA-256) da chave usada pelo agente local. A chave em si nunca é guardada.
  apiKeyHash String?   @unique
  active     Boolean   @default(true)
  lastSeenAt DateTime?

  accessEvents AccessEvent[]
  credentials  MemberCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Credencial de acesso do aluno: digital (biometria), cartão/chaveiro ou senha extra.
model MemberCredential {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: NoAction)
  deviceId       String?
  device         AccessDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  type         CredentialType
  /// Número do cartão, ou identificador da digital no equipamento
  identifier   String?
  /// ID do usuário cadastrado dentro do equipamento (ex.: posição na memória do leitor)
  deviceUserId String?
  /// Template biométrico (base64), quando o leitor permite exportar
  template     String?
  /// Qual dedo (ex.: "indicador direito")
  label        String?
  active       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, type, identifier])
  @@index([memberId])
  @@index([deviceId, deviceUserId])
}

/// Passagem/presença: check-in manual da recepção ou evento da catraca.
model AccessEvent {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?       @relation(fields: [memberId], references: [id], onDelete: NoAction)
  deviceId       String?
  device         AccessDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  method     AccessMethod
  direction  AccessDirection @default(IN)
  result     AccessResult    @default(GRANTED)
  /// Motivo da negação ou observação (ex.: "Plano vencido", "Senha inválida")
  reason     String?
  occurredAt DateTime        @default(now())

  createdAt DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([memberId, occurredAt])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: NoAction)

  type      NotificationType
  title     String
  message   String
  // Chave para idempotência (o job pode rodar várias vezes sem duplicar avisos)
  dedupeKey String
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, readAt])
  @@index([organizationId, createdAt])
}
