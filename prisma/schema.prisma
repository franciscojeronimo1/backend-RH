
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  STAFF
  ADMIN
}

enum TimeRecordType{
  START
  STOP
}

enum Plan{
  FREE
  PREMIUM
}

enum SubscriptionStatus{
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

model Organization{
  id String @id @default(uuid())
  name String
  cnpj String? @unique
  email String?
  phone String?
  address String?

  // Relações
  users User[]
  products Product[]
  categories Category[]
  clients Client[]
  booklets Booklet[]
  stockEntries StockEntry[]
  stockExits StockExit[]
  subscription Subscription?

  // Módulo Academia
  gymSettings GymSettings?
  checkIns CheckIn[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription{
  id String @id @default(uuid())
  organizationId String @unique
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan Plan @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  startedAt DateTime @default(now())
  expiresAt DateTime?
  trialEndsAt DateTime?

  // Stripe
  stripeCustomerId String?
  stripeSubscriptionId String?
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Category{
  id String @id @default(uuid())
  name String
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Client {
  id               String  @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  cpf              String
  phone            String
  email            String?
  street           String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?
  addressReference String?
  notes            String?
  active           Boolean @default(true)

  // Módulo Academia (aluno)
  memberStatus       MemberStatus @default(ACTIVE)
  lastCheckInAt      DateTime?
  activeSince        DateTime?
  planName           String?
  planExpiresAt      DateTime? @db.Date
  autoControl        Boolean @default(true)
  statusChangedAt    DateTime?
  deactivatedAt      DateTime?
  deactivationReason DeactivationReason?

  booklets Booklet[]
  checkIns CheckIn[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, memberStatus])
}

enum BookletParcelStatus {
  PENDING
  PAID
  CANCELLED
}

model Booklet {
  id                 String   @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  description        String?
  notes              String?
  installmentCount   Int
  installmentAmount  Decimal  @db.Decimal(10, 2)
  totalAmount        Decimal  @db.Decimal(10, 2)
  firstDueDate       DateTime @db.Date
  active             Boolean  @default(true)

  parcels BookletParcel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, clientId])
  @@index([clientId])
}

model BookletParcel {
  id        String @id @default(uuid())
  bookletId String
  booklet   Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)

  number    Int
  dueDate   DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  status    BookletParcelStatus @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookletId, number])
  @@index([bookletId])
  @@index([bookletId, status])
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(ADMIN)

  // Relação: Organização (tenant)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relação: STAFF vinculado ao ADMIN que o criou
  createdById String?
  createdBy User? @relation("StaffCreatedByAdmin", fields: [createdById], references: [id], onDelete: SetNull)
  staffCreated User[] @relation("StaffCreatedByAdmin")

  // Relação: Registros de ponto do usuário
  timeRecords TimeRecord[]

  // Relações de estoque
  stockEntries StockEntry[]
  stockExits StockExit[]

  // Check-ins registrados por este usuário (recepção)
  checkInsRegistered CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model TimeRecord{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type TimeRecordType
  timestamp DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, timestamp])
}

model Product{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Identificação
  name String
  code String?
  sku String?
  category String?

  // Estoque
  currentStock Int @default(0)
  minStock Int @default(0)
  unit String @default("UN")

  // Preços
  costPrice Decimal? @db.Decimal(10, 2)
  averageCost Decimal? @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)

  // Status
  active Boolean @default(true)

  // Fornecedor (opcional)
  supplierName String?
  supplierDoc String?

  expirationDate DateTime?

  // Relações
  stockEntries StockEntry[]
  stockExits StockExit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
}

model StockEntry{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da entrada
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  // Fornecedor
  supplierName String?
  supplierDoc String?

  // Nota fiscal
  invoiceNumber String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}

model StockExit{
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Dados da saída
  quantity Int
  unitPrice Decimal? @db.Decimal(10, 2)
  totalPrice Decimal? @db.Decimal(10, 2)

  // Onde foi usado
  projectName String?
  clientName String?
  serviceType String?

  // Usuário que registrou
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, productId])
}
// ================= Módulo Academia =================

enum MemberStatus {
  ACTIVE
  AT_RISK
  INACTIVE
}

enum DeactivationReason {
  AUTO_ABSENCE
  AUTO_PLAN_EXPIRED
  MANUAL
}

enum NotificationType {
  MEMBER_AT_RISK
  MEMBER_DEACTIVATED
  MEMBER_REACTIVATED
  PLAN_EXPIRING
  PLAN_EXPIRED
}

model GymSettings {
  id             String @id @default(uuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled                 Boolean @default(false)
  atRiskAfterDays         Int     @default(7)
  inactiveAfterDays       Int     @default(30)
  autoDeactivate          Boolean @default(true)
  autoReactivateOnCheckIn Boolean @default(true)
  planExpiringNoticeDays  Int     @default(5)
  deactivateOnPlanExpired Boolean @default(false)
  planExpiredGraceDays    Int     @default(5)
  notifyAtRisk            Boolean @default(true)

  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckIn {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String?
  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  checkedInAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([organizationId, checkedInAt])
  @@index([clientId, checkedInAt])
}

model Notification {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String
  // Chave para idempotência (o job pode rodar várias vezes sem duplicar avisos)
  dedupeKey String
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, readAt])
  @@index([organizationId, createdAt])
}
